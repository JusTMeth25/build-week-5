# In sviluppo resta vuota: le chiamate partono relative (/api) e le inoltra il
# proxy di Vite. Su Render: indirizzo completo del backend, senza / finale.
#
#   VITE_API_URL=https://app-be.onrender.com
#
# Vite la legge al momento della BUILD: cambiarla richiede un nuovo deploy.
VITE_API_URL=

# Chiave browser di Google Maps JavaScript API usata dalla pagina /mappa.
# In locale puoi anche usare direttamente la variabile di sistema GOOGLE_MAPS_API_KEY:
# vite.config.ts la mappa automaticamente su VITE_GOOGLE_MAPS_API_KEY.
# Deve avere billing attivo e referrer autorizzati, per esempio:
#   http://localhost:5173/*
#   https://tuo-frontend.onrender.com/*
VITE_GOOGLE_MAPS_API_KEY=
